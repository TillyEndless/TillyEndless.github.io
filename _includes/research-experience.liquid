<div class="research-list">
  {% for project in site.data.research %}
  <article class="research-item research-compact" id="{{ project.id }}">
    <header>
      <h3>{{ project.name }}</h3>
      <span class="profile-meta research-date">{{ project.dates }}</span>
    </header>
    <p class="research-subtitle">{{ project.title }}</p>
    <ul class="research-results">
      {% for bullet in project.bullets %}
      <li>{{ bullet | markdownify | remove: '<p>' | remove: '</p>' | strip }}</li>
      {% endfor %}
    </ul>
    {% if project.url %}
    <div class="research-links">
      <a href="{{ project.url }}">{% if project.id == 'draftkv' %}PDF{% else %}arXiv{% endif %}</a>
      {% if project.code %}<span aria-hidden="true"> · </span><a href="{{ project.code }}">Code</a>{% endif %}
    </div>
    {% endif %}
  </article>
  {% endfor %}
</div>
